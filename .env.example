# MULTBOT — Konfiguration
# Kopieren nach .env und ausfüllen:  cp .env.example .env
# .env ist in .gitignore und darf NIE eingecheckt werden.
# Lokal wird .env aus dem Projektverzeichnis automatisch geladen; relative Pfade gelten relativ zu dieser Datei.

# --- Allgemein ---------------------------------------------------------------------------------
NODE_ENV=production
LOG_LEVEL=info
# Logs zusätzlich in Dateien schreiben (mit Rotation); leer = nur stdout
# LOG_DIR=./logs

# --- Dashboard / API ---------------------------------------------------------------------------
# Lokal nur auf localhost lauschen. Im Docker-Container setzt docker-compose 0.0.0.0 (Port wird nur auf 127.0.0.1 veröffentlicht).
HTTP_HOST=127.0.0.1
HTTP_PORT=8787
# Admin-Passwort-Hash (Pflicht für Echtgeld-Funktionen und jeden Fernzugriff):
#   echo -n 'ein langes, zufälliges Passwort' | pnpm auth:hash-password
ADMIN_PASSWORD_HASH=
SESSION_TTL_HOURS=12

# --- Datenbank ---------------------------------------------------------------------------------
# Lokal:
DATABASE_URL=postgres://multbot:multbot@localhost:5432/multbot
# docker compose: nur das Passwort setzen (DATABASE_URL wird dort automatisch gebildet)
POSTGRES_PASSWORD=bitte-aendern-langes-zufaelliges-passwort

# --- Solana RPC (Helius empfohlen) -------------------------------------------------------------
# API-Key von https://dashboard.helius.dev — ohne Key wird der öffentliche, stark limitierte Endpoint genutzt.
HELIUS_API_KEY=
# Weitere RPC-Endpoints als Fallback (kommagetrennt, optional mit passenden WebSocket-URLs)
# SOLANA_RPC_URLS=https://…,https://…
# SOLANA_WS_URLS=wss://…,wss://…
RPC_REQUESTS_PER_SECOND=10

# --- Ausführung ---------------------------------------------------------------------------------
JUPITER_API_URL=https://lite-api.jup.ag/swap/v1
# JUPITER_API_KEY=

# --- Steuer-Dokumentation (EUR-Kurse) ----------------------------------------------------------
FX_PROVIDER=kraken
# COINGECKO_API_KEY=

# --- Bot-Wallet --------------------------------------------------------------------------------
# Verschlüsselter Keystore (scrypt + AES-256-GCM). Der private Schlüssel wird nie angezeigt,
# geloggt, gespeichert oder an den Browser übertragen.
WALLET_KEYSTORE_PATH=./secrets/bot-wallet.keystore.json
# Passphrase (mind. 12 Zeichen) — bevorzugt als Datei mit Rechten 0600:
WALLET_KEYSTORE_PASSPHRASE_FILE=./secrets/wallet-passphrase.txt
# alternativ direkt (weniger sicher):
# WALLET_KEYSTORE_PASSPHRASE=

# --- Module (Standard: alle an) ----------------------------------------------------------------
# ENABLE_INGEST=true
# ENABLE_RESEARCH=true
# ENABLE_PAPER=true
# ENABLE_LIVE_ENGINE=true

# --- Docker (optional) -------------------------------------------------------------------------
# Benutzer-ID, die den Keystore in ./secrets lesen darf (Standard 1000)
# MULTBOT_UID=1000
# MULTBOT_GID=1000
# MULTBOT_PORT=8787
