{
  "name": "@solarbiter/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx --conditions=source src/main.ts",
    "start": "node dist/main.js",
    "user:create": "tsx --conditions=source src/cli/user.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/static": "^10.1.5",
    "@fastify/websocket": "^11.3.1",
    "@solarbiter/database": "workspace:*",
    "@solarbiter/shared": "workspace:*",
    "@solarbiter/tax": "workspace:*",
    "fastify": "^5.12.5",
    "pino": "^10.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.15",
    "typescript": "5.9.3"
  }
}
