# ------------------------------------------------------------------------------------------------
# SOLARBITER configuration. Copy to .env and adjust. NEVER commit .env (it is git-ignored).
# Secrets (RPC keys, Jupiter key, Jito auth, passphrase) live ONLY here or in files referenced here —
# never in the database, the frontend, logs or git.
# ------------------------------------------------------------------------------------------------

# --- application ------------------------------------------------------------------------------
APP_NAME=SOLARBITER
NODE_ENV=production
LOG_LEVEL=info
# LOG_DIR=./logs

# --- hard switches ------------------------------------------------------------------------------
# PAPER_MODE: paper trading on live market data (default on).
PAPER_MODE=true
# LIVE_MODE=false makes real-money trading technically impossible, whatever the UI says.
# Even with true, live needs: passed validation gate + bot wallet + "ENABLE LIVE TRADING" + password.
LIVE_MODE=false

# --- capital & limits (initial values; afterwards edited in Settings, with audit trail) -----------
STARTING_CAPITAL_EUR=15
MAX_TRADE_EUR=5
MAX_CONCURRENT_TRADES=1
MAX_LOSS_PER_TRADE_EUR=0.30
DAILY_LOSS_LIMIT_EUR=0.75
MAX_QUOTE_AGE_MS=1500
MIN_NET_PROFIT_EUR=0.005
MIN_NET_PROFIT_PERCENT=0.1
MAX_SLIPPAGE_BPS=50

# --- HTTP (API + dashboard) -------------------------------------------------------------------
HTTP_HOST=127.0.0.1
HTTP_PORT=8788
# WEB_DIST_DIR=./apps/web/out          (set automatically in Docker)
# CORS_ORIGINS=                        (only needed if the dashboard runs on another origin)
SESSION_TTL_HOURS=12
WORKER_METRICS_PORT=9464

# --- database / redis (Docker Compose overrides these with the service hostnames) ---------------
DATABASE_URL=postgres://solarbiter:solarbiter@localhost:5432/solarbiter
REDIS_URL=redis://127.0.0.1:6379
POSTGRES_USER=solarbiter
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=solarbiter

# --- Solana RPC -------------------------------------------------------------------------------
# The public endpoint works for paper trading but is rate limited; use a dedicated RPC (Helius,
# Triton, QuickNode …) for anything serious. Keys inside URLs are scrubbed from every log line.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# SOLANA_WS_URL=
# SOLANA_RPC_FALLBACK_URLS=https://rpc-a.example,https://rpc-b.example
RPC_REQUESTS_PER_SECOND=8

# --- Jupiter routing API ----------------------------------------------------------------------
# Keyless: https://lite-api.jup.ag/swap/v1 at 0.5 rps (30 requests / 60 s sliding window).
# With a key (portal: developers.jup.ag) the client switches to api.jup.ag automatically.
JUPITER_API_URL=https://lite-api.jup.ag/swap/v1
# JUPITER_API_KEY=
JUPITER_RPS=0.5

# --- Jito ---------------------------------------------------------------------------------------
JITO_BLOCK_ENGINE_URL=https://mainnet.block-engine.jito.wtf
JITO_TIP_FLOOR_URL=https://bundles.jito.wtf/api/v1/bundles/tip_floor
# JITO_AUTH=

# --- SOL/EUR (sizing, limits, reporting, tax) ---------------------------------------------------
FX_URL=https://api.kraken.com/0/public/Ticker?pair=SOLEUR

# --- bot wallet (only needed for SHADOW and LIVE) -------------------------------------------------
# Create with `pnpm wallet:create` (encrypted keystore, scrypt + AES-256-GCM). The private key never
# leaves the worker's signer. Passphrase: env var or a file with chmod 600.
WALLET_KEYSTORE_PATH=./secrets/bot-wallet.keystore.json
# WALLET_KEYSTORE_PASSPHRASE=
# WALLET_KEYSTORE_PASSPHRASE_FILE=./secrets/wallet_passphrase

# --- notifications --------------------------------------------------------------------------------
# NOTIFY_WEBHOOK_URL=https://hooks.example/...   (errors, live trades, emergency stop; secrets scrubbed)
